# =========================================================
# EasyDrop Backend - Local Environment
# =========================================================

# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=1

ALLOWED_HOSTS=127.0.0.1,localhost


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------------------------------------------------------
# PostgreSQL - Local
# ---------------------------------------------------------

DB_NAME=easydrop
DB_USER=easydrop
DB_PASSWORD=easydrop
DB_HOST=localhost
DB_PORT=5432


# ---------------------------------------------------------
# Order / Delivery
# ---------------------------------------------------------

DELIVERY_INSIDE=60
DELIVERY_SUB=100
DELIVERY_OUTSIDE=120
MIN_WITHDRAW=500
HOLD_DAYS=0


# ---------------------------------------------------------
# SMS - BulkSMSBD
# ---------------------------------------------------------
# 0 = Real SMS
# 1 = Mock

SMS_MOCK=0

SMS_API_KEY=YOUR_REAL_BULKSMSBD_API_KEY
SMS_SENDER_ID=YOUR_APPROVED_SENDER_ID
SMS_URL=http://bulksmsbd.net/api/smsapi

# ---------------------------------------------------------
# Added in v2 (all optional)
# ---------------------------------------------------------
# Admin login created on every deploy (default easydrop / easydrop)
ADMIN_USER=easydrop
# ADMIN_PASSWORD=easydrop
# SMS: SMS_API_KEY and SMS_SENDER_ID are required (no built-in key any more). On Render add them under Environment.
# Render sets DATABASE_URL by itself. Locally the DB_* values above are used.
